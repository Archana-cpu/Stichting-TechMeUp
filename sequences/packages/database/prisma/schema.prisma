generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// AUTH MODELS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  image         String?
  bio           String?
  birthday      DateTime?
  locale        String    @default("en")
  theme         String    @default("dark-calm")
  isAdmin       Boolean   @default(false)
  onboardingComplete Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  sequences        Sequence[]
  memories         Memory[]
  people           Person[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reactions        Reaction[]
  comments         Comment[]
  followers        Follow[]  @relation("Following")
  following        Follow[]  @relation("Followers")
  notifications    Notification[]
  userSettings     UserSettings?
  invitationsSent  Invitation[] @relation("InvitationsSent")

  @@index([username])
  @@index([email])
  @@index([createdAt])
  @@index([isAdmin])
  @@index([onboardingComplete])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expiresAt])
}

// ============================================================================
// USER SETTINGS
// ============================================================================

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  publicProfile         Boolean  @default(false)
  showInPeopleSearch    Boolean  @default(true)
  
  storyboardViewMode    String   @default("timeline")
  storyboardLayout      String   @default("horizontal")
  fontPairing           String?  // e.g., 'elegant', 'literary', 'airy', 'modern'
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================================================
// CBT CORE MODELS
// ============================================================================

model Emotion {
  id          Int        @id @default(autoincrement())
  key         String     @unique
  icon        String
  colorHsl    String
  sequences   Sequence[]
}

model Trigger {
  id        Int        @id @default(autoincrement())
  key       String     @unique
  icon      String
  sequences Sequence[]
}

model Sequence {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventDate        DateTime
  title            String
  summary          String   @db.Text
  image            String?
  isPublic         Boolean  @default(false)
  isCoreMemory     Boolean  @default(false)
  storyboardOrder  Float    @default(0)
  positionX        Float?
  positionY        Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  emotionId        Int
  emotion          Emotion  @relation(fields: [emotionId], references: [id])
  emotionPolarity  Int      @db.SmallInt
  emotionIntensity Int      @db.SmallInt

  triggerId        Int
  trigger          Trigger @relation(fields: [triggerId], references: [id])

  thoughtContent   String @db.Text
  thoughtPolarity  Int    @db.SmallInt
  thoughtIntensity Int    @db.SmallInt

  behaviorContent  String @db.Text
  behaviorPolarity Int    @db.SmallInt
  behaviorImpact   Int    @db.SmallInt

  memoryId         String?
  memory           Memory?  @relation(fields: [memoryId], references: [id])

  notes            Note[]
  people           SequencePerson[]
  reactions        Reaction[]
  comments         Comment[]

  @@index([userId])
  @@index([eventDate])
  @@index([isPublic])
  @@index([storyboardOrder])
  @@index([memoryId])
  @@index([userId, storyboardOrder])
  @@index([userId, eventDate])
  @@index([userId, isPublic])
  @@index([emotionId, userId])
  @@index([createdAt])
}

model Note {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([sequenceId])
}

// ============================================================================
// MEMORY (GROUPED SEQUENCES)
// ============================================================================

model Memory {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  coverImage  String?
  isPublic    Boolean    @default(false)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sequences   Sequence[]

  @@index([userId])
  @@index([isPublic])
}

// ============================================================================
// PEOPLE I KNOW (WITH RELATIONSHIP TREE)
// ============================================================================

model Person {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  notes        String?         @db.Text
  image        String?
  appUserId    String?
  birthday     DateTime?
  
  parentId     String?
  parent       Person?         @relation("PersonTree", fields: [parentId], references: [id])
  children     Person[]        @relation("PersonTree")
  
  positionX    Float?
  positionY    Float?
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sequences    SequencePerson[]
  relationsFrom PersonRelation[] @relation("RelationFrom")
  relationsTo   PersonRelation[] @relation("RelationTo")

  @@index([userId])
  @@index([appUserId])
  @@index([parentId])
}

model PersonRelation {
  id           String   @id @default(cuid())
  fromPersonId String
  fromPerson   Person   @relation("RelationFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPersonId   String
  toPerson     Person   @relation("RelationTo", fields: [toPersonId], references: [id], onDelete: Cascade)
  relationType String
  
  @@unique([fromPersonId, toPersonId])
  @@index([fromPersonId])
  @@index([toPersonId])
}

model SequencePerson {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  role       String?

  @@unique([sequenceId, personId])
  @@index([sequenceId])
  @@index([personId])
}

// ============================================================================
// INVITATION SYSTEM
// ============================================================================

model Invitation {
  id          String    @id @default(cuid())
  email       String
  inviterId   String
  inviter     User      @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  token       String    @unique
  status      String    @default("pending")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([inviterId])
  @@index([token])
}

// ============================================================================
// SOCIAL FEATURES
// ============================================================================

model Message {
  id         String   @id @default(cuid())
  content    String   @db.Text
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
  createdAt  DateTime @default(now())

  @@index([sequenceId])
  @@index([userId])
}

model Reaction {
  id         String   @id @default(cuid())
  type       String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, sequenceId, type])
  @@index([sequenceId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  title         String
  body          String?
  read          Boolean  @default(false)
  referenceId   String?
  referenceType String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([read])
}

// ============================================================================
// WISDOM QUOTES (Psychology, Philosophy, Sociology)
// ============================================================================

model Quote {
  id          String   @id @default(cuid())
  textEn      String   @db.Text
  textTr      String   @db.Text
  textNl      String   @db.Text
  author      String
  source      String?
  category    String
  emotionKeys String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ============================================================================
// ADMIN SYSTEM SETTINGS
// ============================================================================

model SystemSettings {
  id                  String   @id @default("system")
  
  appName             String   @default("Sequences")
  appDescription      String?  @db.Text
  
  logoLight           String?
  logoDark            String?
  faviconLight        String?
  faviconDark         String?
  
  primaryColor        String   @default("262 83% 58%")
  accentColor         String   @default("262 83% 58%")
  
  defaultTheme        String   @default("dark-calm")
  defaultLocale       String   @default("en")
  
  fontHeading         String   @default("Geist Sans")
  fontBody            String   @default("Geist Sans")
  
  maintenanceMode     Boolean  @default(false)
  registrationEnabled Boolean  @default(true)
  inviteOnlyMode      Boolean  @default(false)
  
  quotesEnabled       Boolean  @default(true)
  splashQuotes        Boolean  @default(true)
  dailyQuoteNotif     Boolean  @default(true)
  
  maxSequencesPerUser Int      @default(0)
  maxPeoplePerUser    Int      @default(0)
  maxMemoriesPerUser  Int      @default(0)
  
  updatedAt           DateTime @updatedAt
}

// ============================================================================
// ADMIN CONTENT MANAGEMENT
// ============================================================================

model ContentBlock {
  id          String   @id @default(cuid())
  key         String   @unique
  titleEn     String
  titleTr     String
  titleNl     String
  contentEn   String   @db.Text
  contentTr   String   @db.Text
  contentNl   String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([isActive])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
