{
  "name": "@voxpoll/api",
  "version": "1.0.0",
  "private": true,
  "description": "VoxPoll API - Hono REST API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-openapi": "^0.18.0",
    "@hono/zod-validator": "^0.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^8.40.0",
    "@voxpoll/algorithms": "workspace:*",
    "@voxpoll/database": "workspace:*",
    "hono": "^4.6.0",
    "ioredis": "^5.9.2",
    "jose": "^5.9.0",
    "otpauth": "^9.4.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "resend": "^6.8.0",
    "sharp": "^0.34.5",
    "stripe": "^17.0.0",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@scalar/hono-api-reference": "^0.5.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.0.18",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
