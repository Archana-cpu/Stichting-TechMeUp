{
  "name": "@voxpoll/validators",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VoxPoll Validators Package - Zod schemas and validation utilities",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./src/auth.ts"
    },
    "./poll": {
      "types": "./src/poll.ts",
      "default": "./src/poll.ts"
    },
    "./user": {
      "types": "./src/user.ts",
      "default": "./src/user.ts"
    },
    "./common": {
      "types": "./src/common.ts",
      "default": "./src/common.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@voxpoll/shared": "workspace:*"
  }
}
