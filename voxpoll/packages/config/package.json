{
  "name": "@voxpoll/config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VoxPoll Config Package - Shared configuration files (ESLint, TypeScript, Tailwind, etc.)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./eslint": {
      "default": "./eslint.config.js"
    },
    "./tailwind": {
      "default": "./tailwind.config.ts"
    },
    "./typescript/base": {
      "default": "./typescript/base.json"
    },
    "./typescript/react": {
      "default": "./typescript/react.json"
    },
    "./typescript/node": {
      "default": "./typescript/node.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@eslint/js": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
