# ══════════════════════════════════════════════════════════════════════════════
# VOXPOLL - PNPM CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Optimized for monorepo performance

# Hoist all dependencies for better deduplication
shamefully-hoist=true

# Use strict peer dependencies
strict-peer-dependencies=false

# Auto-install peers
auto-install-peers=true

# Use symlinks for workspace packages (faster)
prefer-workspace-packages=true

# Store directory (default is fine, but explicit)
# store-dir=~/.pnpm-store

# Registry
registry=https://registry.npmjs.org/

# Lockfile settings
lockfile=true
prefer-frozen-lockfile=true

# Performance
fetch-retries=3
fetch-retry-factor=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Node version (match engines in package.json)
use-node-version=22.0.0

# Don't update package.json when running pnpm add -w
save-workspace-protocol=rolling

# Enable content-addressable store (default, but explicit)
modules-cache-max-age=10080

# Suppress deprecation warnings for transitive dependencies
loglevel=error
