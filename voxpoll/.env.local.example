# VoxPoll Local Development Environment Variables
# Copy this file to .env.local and update values as needed
# All services configured for FREE test mode

# ═══════════════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE (Docker PostgreSQL - FREE)
# ═══════════════════════════════════════════════════════════════════════════

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voxpoll_dev

# ═══════════════════════════════════════════════════════════════════════════
# REDIS CACHE (Docker Redis - FREE)
# ═══════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════════
# JWT SECRETS (Generate with: openssl rand -hex 32)
# ═══════════════════════════════════════════════════════════════════════════

JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL (MailHog - FREE Docker container)
# ═══════════════════════════════════════════════════════════════════════════

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@voxpoll.local
SMTP_SECURE=false

# MailHog Web UI: http://localhost:8025
MAILHOG_UI=http://localhost:8025

# Alternative: Resend Test Mode (optional)
# RESEND_API_KEY=re_test_...

# ═══════════════════════════════════════════════════════════════════════════
# SMS (Mock Mode - FREE, Console Log Only)
# ═══════════════════════════════════════════════════════════════════════════

MOCK_SMS=true
SMS_PROVIDER=mock

# Optional: Twilio Test Credentials (FREE test mode, no real SMS)
# TWILIO_ACCOUNT_SID=ACtest...
# TWILIO_AUTH_TOKEN=test_token
# TWILIO_PHONE_NUMBER=+15005550006

# ═══════════════════════════════════════════════════════════════════════════
# PAYMENTS (Stripe Test Mode - FREE)
# ═══════════════════════════════════════════════════════════════════════════

STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# ═══════════════════════════════════════════════════════════════════════════
# SEARCH (Meilisearch Docker - FREE)
# ═══════════════════════════════════════════════════════════════════════════

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=test_master_key_for_local_dev

# Meilisearch Web UI: http://localhost:7700

# ═══════════════════════════════════════════════════════════════════════════
# FILE STORAGE (MinIO S3-compatible - FREE Docker container)
# ═══════════════════════════════════════════════════════════════════════════

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=voxpoll-uploads
S3_REGION=us-east-1

# MinIO Console UI: http://localhost:9001

# Alternative: AWS S3 (production)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_S3_BUCKET=voxpoll-uploads-dev

# ═══════════════════════════════════════════════════════════════════════════
# LIVE POLLS (Partykit Local Dev - FREE)
# ═══════════════════════════════════════════════════════════════════════════

PARTYKIT_HOST=http://localhost:1999
PARTYKIT_MODE=development

# Start Partykit dev server: npx partykit dev

# ═══════════════════════════════════════════════════════════════════════════
# MONITORING (Optional - Sentry Test Mode)
# ═══════════════════════════════════════════════════════════════════════════

# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════

ENABLE_MOCK_SERVICES=true
ENABLE_DEBUG_LOGGING=true

# ═══════════════════════════════════════════════════════════════════════════
# OAUTH (e-Devlet, SSO - Test Mode)
# ═══════════════════════════════════════════════════════════════════════════

# e-Devlet (Test credentials)
EDEVLET_CLIENT_ID=test_client_id
EDEVLET_CLIENT_SECRET=test_client_secret
EDEVLET_REDIRECT_URI=http://localhost:3000/auth/edevlet/callback

# SSO SAML (Test)
# SSO_SAML_ENTRY_POINT=https://test-sso.example.com/saml
# SSO_SAML_ISSUER=voxpoll-dev
# SSO_SAML_CERT=...

# ═══════════════════════════════════════════════════════════════════════════
# QUICK START
# ═══════════════════════════════════════════════════════════════════════════

# 1. Copy this file: cp .env.local.example .env.local
# 2. Start Docker services: docker-compose -f docker-compose.dev.yml up -d
# 3. Run migrations: pnpm db:migrate
# 4. Start dev server: pnpm dev

# ═══════════════════════════════════════════════════════════════════════════
# SERVICE URLS (After starting Docker)
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL: localhost:5432
# Redis: localhost:6379
# Meilisearch UI: http://localhost:7700
# MailHog UI: http://localhost:8025
# MinIO Console: http://localhost:9001
# API: http://localhost:3000
# Web: http://localhost:3001

# Total Cost: $0 (Completely FREE for local development)
